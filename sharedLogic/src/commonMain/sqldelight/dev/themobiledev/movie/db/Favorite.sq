CREATE TABLE favoriteMovie (
    id INTEGER NOT NULL UNIQUE,
    title TEXT NOT NULL,
    overview TEXT NOT NULL,
    posterPath TEXT,
    releaseDate TEXT,
    voteAverage REAL NOT NULL
);

insertFavorite:
INSERT OR REPLACE INTO favoriteMovie(id, title, overview, posterPath, releaseDate, voteAverage)
VALUES (?, ?, ?, ?, ?, ?);

removeFavorite:
DELETE FROM favoriteMovie WHERE id = :id;

selectAllFavorites:
SELECT * FROM favoriteMovie ORDER BY rowid DESC;

isFavorite:
SELECT EXISTS(SELECT 1 FROM favoriteMovie WHERE id = :id);
